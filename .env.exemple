# Copier en .env (ignoré par Git) et adapter. Lu par scripts/publish-dev.sh et scripts/release.sh.
# Hôte Docker (connecté à ghcr.io) qui construit l'image amd64, joint en SSH :
DOCKER_SSH=root@nas.exemple.fr
# Dossier de ce dépôt vu depuis l'hôte Docker (dossier partagé avec le poste de travail) :
REMOTE_DIR=/chemin/vers/portique
# Hôte arm64, joint en SSH DEPUIS l'hôte Docker, qui construit l'image arm64 en natif :
ARM_HOST=arm64.exemple.fr
# Déploiements à relancer après publish-dev.sh : « hôte:dossier », « - » = l'hôte Docker lui-même.
DEPLOY="-:/srv/portique arm64.exemple.fr:/srv/portique"
