# Copier en .env (ignoré par Git) et adapter. Lu par scripts/publish-dev.sh (image de branche :dev).
# Hôte Docker (connecté à ghcr.io) qui construit l'image amd64, joint en SSH :
DOCKER_SSH=root@nas.exemple.fr
# Dossier de ce dépôt vu depuis l'hôte Docker (dossier partagé avec le poste de travail) :
REMOTE_DIR=/chemin/vers/portique
# Hôte arm64, joint en SSH DEPUIS l'hôte Docker, qui construit l'image arm64 en natif :
ARM_HOST=arm64.exemple.fr
# Facultatif : dossier docker compose (sur l'hôte Docker) d'un déploiement qui suit :dev, redéployé après publication :
# DEPLOY_DIR=/chemin/vers/deploiement
# Facultatif : autres déploiements qui suivent :dev, joints en SSH depuis l'hôte Docker (« hôte:dossier », séparés par « ; ») :
# DEPLOY_OTHERS="secours.exemple.fr:/chemin/vers/deploiement;autre.exemple.fr:/srv/mon deploiement"
