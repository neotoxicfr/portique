Windows Registry Editor Version 5.00

; Annule portique.reg : retire les strategies posees et referme le Bureau a distance.
; Complement : portique.cmd annuler (pare-feu, demarrage rapide).
; Sources : memes que portique.reg ; la syntaxe "nom"=- supprime une valeur (support.microsoft.com/kb/310516).

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server]
"fDenyTSConnections"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations]
"DWMFRAMEINTERVAL"=-

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Power]
"HiberbootEnabled"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services]
"UserAuthentication"=-
"SecurityLayer"=-
"AVC444ModePreferred"=-
"AVCHardwareEncodePreferred"=-
"bEnumerateHWBeforeSW"=-
"fEnableWddmDriver"=-
"ImageQuality"=-
"fDisableClip"=-
"fDisableCdm"=-
"fDisableCam"=-
"fDisableAudioCapture"=-
"MaxIdleTime"=-
"MaxDisconnectionTime"=-
"MaxConnectionTime"=-
