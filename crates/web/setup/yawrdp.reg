Windows Registry Editor Version 5.00

; yawrdp : prepare Windows 10/11 Pro pour le Bureau a distance. Relancable sans risque.
; A completer par yawrdp.cmd (pare-feu, Wake-on-LAN, demarrage rapide, gpupdate).
; Annulation : annuler.reg
; Sources (verifiees contre TerminalServer.admx, modeles Windows 11 25H2, et les pages Learn) :
;   - Politiques (cle SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services, noms de valeur et donnees) :
;     learn.microsoft.com/windows/client-management/mdm/policy-csp-admx-terminalserver
;     (TS_USER_AUTHENTICATION_POLICY, TS_SECURITY_LAYER_POLICY, TS_SERVER_AVC444_MODE_PREFERRED,
;      TS_SERVER_AVC_HW_ENCODE_PREFERRED, TS_DX_USE_FULL_HWGPU, TS_SERVER_WDDM_GRAPHICS_DRIVER,
;      TS_SERVER_IMAGE_QUALITY, TS_CLIENT_CLIPBOARD, TS_CLIENT_DRIVE_M, TS_CLIENT_AUDIO,
;      TS_CLIENT_AUDIO_CAPTURE, TS_SESSIONS_*)
;   - fDenyTSConnections : learn.microsoft.com/windows-hardware/customize/desktop/unattend/microsoft-windows-terminalservices-localsessionmanager-fdenytsconnections
;   - DWMFRAMEINTERVAL : learn.microsoft.com/troubleshoot/windows-server/remote/frame-rate-limited-to-30-fps
;   - Delais en millisecondes, 0 = jamais : learn.microsoft.com/troubleshoot/windows-server/remote/troubleshoot-unexpected-rds-session-locks-or-disconnections

; --- Activer le Bureau a distance (0 = connexions autorisees) ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server]
"fDenyTSConnections"=dword:00000000

; --- 60 images/s : DWMFRAMEINTERVAL = 15 (decimal) ---
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations]
"DWMFRAMEINTERVAL"=dword:0000000f

; --- GPO : graphiques, redirections, delais ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services]
; NLA obligatoire (UserAuthentication 1 = actif) et couche TLS (SecurityLayer 2 = SSL/TLS ; 0 = RDP, 1 = negocie)
"UserAuthentication"=dword:00000001
"SecurityLayer"=dword:00000002
; AVC 4:4:4 prioritaire, encodage materiel H.264, GPU pour toutes les sessions, pilote WDDM
"AVC444ModePreferred"=dword:00000001
"AVCHardwareEncodePreferred"=dword:00000001
"bEnumerateHWBeforeSW"=dword:00000001
"fEnableWddmDriver"=dword:00000001
; Qualite visuelle RemoteFX Adaptive Graphics : 1 = sans perte, 2 = haute, 3 = moyenne, 4 = basse
"ImageQuality"=dword:00000002
; (pas de ColorDepth : la strategie ne s'applique pas aux clients RDP 8.0 et plus, toujours en 32 bits)
; Redirections autorisees : fDisableClip / fDisableCdm = 1 interdit, 0 autorise ;
; fDisableCam / fDisableAudioCapture = 0 autorise, 1 interdit
"fDisableClip"=dword:00000000
"fDisableCdm"=dword:00000000
"fDisableCam"=dword:00000000
"fDisableAudioCapture"=dword:00000000
; Jamais de deconnexion automatique (millisecondes ; 0 = "Jamais")
"MaxIdleTime"=dword:00000000
"MaxDisconnectionTime"=dword:00000000
"MaxConnectionTime"=dword:00000000
